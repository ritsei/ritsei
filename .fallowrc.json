{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "runtime/api/mod.ts",
    "runtime/auth/bootstrap.ts",
    "runtime/migrator/mod.ts",
    "runtime/migrator/p0-backfill.ts",
    "runtime/worker/mod.ts",
    "apps/web/src/features/process-studio/index.ts",
    "apps/web/src/experiments/solid-effect/src/main.tsx",
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "foundation/mod.ts",
    "foundation/*/mod.ts",
    "foundation/**/*.test.ts",
    "foundation/**/*.test.tsx",
    "modules/*/mod.ts",
    "modules/**/*.test.ts",
    "modules/**/*.test.tsx",
    "platform/mod.ts",
    "platform/*/mod.ts",
    "platform/**/*.test.ts",
    "platform/**/*.test.tsx",
    "runtime/**/*.test.ts",
    "runtime/**/*.test.tsx",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "tooling/**/*.ts",
    "db/schema/index.ts",
    "drizzle.config.ts"
  ],
  "ignorePatterns": [
    "vendor/**",
    "db/migrations/**",
    "**/*.d.ts",
    ".auto/**"
  ],
  "ignoreDependencies": [
    "@axe-core/playwright",
    "@effect/vitest",
    "@effect/platform-node-shared",
    "@effect/sql-pg",
    "@std/fs",
    "@std/media-types",
    "@std/streams",
    "effect"
  ],
  "ignoreExports": [
    {
      "file": "modules/authorization/src/capabilities.ts",
      "exports": ["Capability"]
    },
    {
      "file": "modules/authorization/src/contract.ts",
      "exports": ["Capability"]
    },
    {
      "file": "modules/accounting/src/contract.ts",
      "exports": [
        "ListAccountingConfigurationsInput",
        "ListAccountsInput",
        "ListAccountingPeriodsInput",
        "ListRevenuePostingProfilesInput",
        "ListJournalEntriesInput"
      ]
    },
    {
      "file": "modules/authorization/src/capabilities.ts",
      "exports": ["CapabilityScope", "CapabilityStability"]
    },
    {
      "file": "modules/auth/src/contract.ts",
      "exports": ["ExternalIdentityType", "IdentityProviderShape"]
    },
    {
      "file": "modules/inventory/src/contract.ts",
      "exports": ["StockMovementKind"]
    },
    {
      "file": "modules/procurement/src/contract.ts",
      "exports": ["PurchaseOrderStatus"]
    }
  ],
  "rulePacks": ["./tooling/fallow/rules/ritsei-static-policy.json"],
  "rules": {
    "policy-violation": "error"
  },
  "audit": {
    "gate": "all",
    "css": false,
    "cssDeep": false,
    "deadCodeBaseline": "tooling/fallow/baselines/dead-code.json",
    "healthBaseline": "tooling/fallow/baselines/health.json",
    "dupesBaseline": "tooling/fallow/baselines/dupes.json"
  },
  "boundaries": {
    "zones": [
      {
        "name": "tests",
        "patterns": [
          "tests/**",
          "apps/**/*.test.ts",
          "apps/**/*.test.tsx",
          "foundation/**/*.test.ts",
          "foundation/**/*.test.tsx",
          "modules/**/*.test.ts",
          "modules/**/*.test.tsx",
          "platform/**/*.test.ts",
          "platform/**/*.test.tsx",
          "runtime/**/*.test.ts",
          "runtime/**/*.test.tsx"
        ]
      },
      {
        "name": "configs",
        "patterns": ["*.config.ts"]
      },
      {
        "name": "apps-web-ui-public",
        "patterns": [
          "apps/web/src/ui/foundations/layout.ts",
          "apps/web/src/ui/foundations/typography.ts",
          "apps/web/src/ui/primitives/badge.tsx",
          "apps/web/src/ui/primitives/button.tsx",
          "apps/web/src/ui/primitives/dialog.tsx",
          "apps/web/src/ui/primitives/form-field.tsx",
          "apps/web/src/ui/primitives/input.tsx",
          "apps/web/src/ui/primitives/form.tsx",
          "apps/web/src/ui/primitives/money-field.tsx",
          "apps/web/src/ui/primitives/party-field.tsx",
          "apps/web/src/ui/primitives/quantity-field.tsx",
          "apps/web/src/ui/primitives/select.tsx",
          "apps/web/src/ui/primitives/tabs.tsx",
          "apps/web/src/ui/recipes/control.ts",
          "apps/web/src/ui/recipes/surface.ts",
          "apps/web/src/ui/patterns/approval-composition.tsx",
          "apps/web/src/ui/patterns/approval.tsx",
          "apps/web/src/ui/patterns/bulk-operation.tsx",
          "apps/web/src/ui/patterns/command-surface.tsx",
          "apps/web/src/ui/patterns/confirm-dialog.tsx",
          "apps/web/src/ui/patterns/entity-workspace.tsx",
          "apps/web/src/ui/patterns/exception-investigation.tsx",
          "apps/web/src/ui/patterns/filter-bar.tsx",
          "apps/web/src/ui/patterns/master-detail.tsx",
          "apps/web/src/ui/patterns/operational-workspace.tsx",
          "apps/web/src/ui/patterns/data-table.tsx",
          "apps/web/src/ui/patterns/ritsei-virtual-list.tsx",
          "apps/web/src/ui/patterns/settings.tsx",
          "apps/web/src/ui/icons/index.ts",
          "apps/web/src/ui/icons/icon.tsx",
          "apps/web/src/ui/motion/index.ts",
          "apps/web/src/ui/grammar/archetypes.ts",
          "apps/web/src/ui/grammar/deterministic-variation.ts",
          "apps/web/src/ui/grammar/primitives.ts",
          "apps/web/src/ui/grammar/projection.ts",
          "apps/web/src/ui/grammar/visual-intent.ts",
          "apps/web/src/ui/interaction/contract.ts",
          "apps/web/src/ui/renderers/cartography/cartography-field.tsx"
        ]
      },
      {
        "name": "apps-web-ui-bootstrap",
        "patterns": ["apps/web/src/ui/styles.ts"]
      },
      {
        "name": "apps-web-ui-internal",
        "patterns": ["apps/web/src/ui/**"]
      },
      {
        "name": "apps-web",
        "patterns": ["apps/web/**"]
      },
      {
        "name": "runtime-adapters",
        "patterns": ["runtime/adapters/**"]
      },
      {
        "name": "runtime",
        "patterns": ["runtime/**"]
      },
      {
        "name": "foundation",
        "patterns": ["foundation/**"]
      },
      {
        "name": "modules",
        "patterns": ["modules/**"]
      },
      {
        "name": "platform",
        "patterns": ["platform/**"]
      },
      {
        "name": "database",
        "patterns": ["db/**"]
      },
      {
        "name": "tooling",
        "patterns": ["tooling/**"]
      }
    ],
    "rules": [
      {
        "from": "tests",
        "allow": [
          "apps-web",
          "foundation",
          "modules",
          "platform",
          "runtime",
          "runtime-adapters",
          "database",
          "tooling",
          "configs",
          "apps-web-ui-public",
          "apps-web-ui-internal",
          "apps-web-ui-bootstrap"
        ]
      },
      {
        "from": "configs",
        "allow": ["tooling"]
      },
      {
        "from": "apps-web-ui-public",
        "allow": ["apps-web-ui-internal"]
      },
      {
        "from": "apps-web-ui-bootstrap",
        "allow": ["apps-web-ui-internal"]
      },
      {
        "from": "apps-web-ui-internal",
        "allow": ["apps-web-ui-public"]
      },
      {
        "from": "apps-web",
        "allow": [
          "modules",
          "foundation",
          "apps-web-ui-public",
          "apps-web-ui-bootstrap"
        ]
      },
      {
        "from": "runtime-adapters",
        "allow": ["runtime", "modules", "platform", "foundation", "database"]
      },
      {
        "from": "runtime",
        "allow": [
          "runtime-adapters",
          "runtime",
          "modules",
          "platform",
          "foundation",
          "database",
          "tooling"
        ]
      },
      {
        "from": "foundation",
        "allow": ["foundation"]
      },
      {
        "from": "modules",
        "allow": ["modules", "foundation", "database"]
      },
      {
        "from": "platform",
        "allow": ["platform", "foundation", "modules"]
      },
      {
        "from": "database",
        "allow": ["database"]
      },
      {
        "from": "tooling",
        "allow": ["tooling", "runtime", "foundation", "modules", "platform", "database"]
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  }
}
