{
  "workspace": ["./apps/web"],
  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "deno.ns"]
  },
  "preferPackageJson": true,
  "nodeModulesDir": "auto",
  "exclude": [
    "node_modules/",
    "vendor/"
  ],
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-env --allow-net runtime/api/mod.ts",
    "worker": "deno run -A runtime/worker/mod.ts",
    "auth:bootstrap": "deno run -A runtime/auth/bootstrap.ts",
    "db:generate": "deno run -A npm:drizzle-kit@1.0.0-rc.4 generate --config=drizzle.config.ts",
    "db:migrate": "deno run -A npm:drizzle-kit@1.0.0-rc.4 migrate --config=drizzle.config.ts",
    "db:check": "deno run -A npm:drizzle-kit@1.0.0-rc.4 check --config=drizzle.config.ts",
    "document:benchmark": "deno run tooling/document-rendering/benchmark.ts",
    "test": "deno task --cwd apps/web contracts && vitest run",
    "test:related": "vitest related --run",
    "check:affected": "deno run --allow-read --allow-run tooling/affected-check.ts",
    "test:coverage": "vitest run --coverage --coverage.provider=v8",
    "test:identity-coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=modules/identity/src/**/*.ts --coverage.thresholds.100 modules/identity/tests",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "lefthook:install": "lefthook install",
    "fallow": "npx --no-install fallow",
    "fallow:audit": "npx --no-install fallow audit --format json --quiet",
    "fallow:dead-code": "npx --no-install fallow dead-code",
    "fallow:dupes": "npx --no-install fallow dupes",
    "fallow:health": "npx --no-install fallow health",
    "fallow:boundaries": "npx --no-install fallow dead-code --boundary-violations",
    "fallow:fix:dry-run": "npx --no-install fallow fix --dry-run",
    "skills:check": "deno run --allow-read tooling/check-agent-skills.ts",
    "release:metadata": "deno run --allow-read --allow-env --allow-run tooling/release-check.ts",
    "release:check": "deno fmt --check && deno lint && deno task check && deno task db:check && deno task roadmap:measure && deno task skills:check && deno task boundary:test && deno task boundary:lint && deno task test && deno task fallow:audit",
    "architecture:check": "deno run --allow-read --allow-env tooling/architecture.ts",
    "financial:gate": "deno run --allow-read tooling/financial-gate.ts",
    "roadmap:measure": "deno run --allow-read --allow-run tooling/roadmap-completion/measure.ts",
    "boundary:lint": "ast-grep scan apps foundation modules platform runtime tooling tests && deno task fallow:boundaries && deno task architecture:check && deno run --allow-read --allow-env tooling/schema-ownership.ts",
    "postgres19:rehearse": "deno run --allow-env --allow-net --allow-read --allow-write tooling/postgresql-19/rehearse.ts",
    "production:artifacts": "deno run -A tooling/production/artifacts.ts",
    "boundary:test": "ast-grep test --skip-snapshot-tests",
    "check": "deno task --cwd apps/web contracts && deno check foundation modules platform runtime tooling tests db apps/web/src/features/process-studio *.config.ts && deno task --cwd apps/web check"
  },
  "fmt": {
    "include": [
      "apps/",
      "foundation/",
      "modules/",
      "platform/",
      "runtime/",
      "tooling/",
      "tests/",
      "db/",
      "*.config.ts",
      "deno.json",
      "sgconfig.yml"
    ],
    "exclude": [
      "db/migrations/**/snapshot.json"
    ],
    "useTabs": false,
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "allowScripts": [
    "npm:msgpackr-extract"
  ]
}
