DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/ritsei
RITSEI_DEPLOYMENT_PROFILE=entry
RITSEI_FINANCIAL_AUTHORITY=postgresql
# Local development uses an explicit transitional session profile.
RITSEI_AUTH_PROFILE=transitional-local
RITSEI_TRANSITIONAL_USER_ACCOUNT_EMAIL=admin@example.test
# RITSEI_TRANSITIONAL_USER_ACCOUNT_ID=00000000-0000-4000-8000-000000000001
# Run `deno task auth:bootstrap` once to create the local account, tenant, memberships, and ERP baseline.
# RITSEI_BOOTSTRAP_EMAIL=admin@example.test
# RITSEI_BOOTSTRAP_TENANT_SLUG=local
# RITSEI_BOOTSTRAP_ORGANIZATION_NAME=Local Organization
# RITSEI_BOOTSTRAP_BRANCH_NAME=Main Branch
# RITSEI_BOOTSTRAP_WAREHOUSE_NAME=Main Warehouse
# RITSEI_BOOTSTRAP_EXTERNAL_ISSUER=https://id.example.com
# RITSEI_BOOTSTRAP_EXTERNAL_SUBJECT=provider-subject
# Production OIDC profile requires all values below.
# RITSEI_AUTH_PROFILE=oidc
# RITSEI_OIDC_ISSUER_URL=https://id.example.com
# RITSEI_OIDC_AUDIENCE=ritsei-api
# RITSEI_OIDC_CLIENT_ID=ritsei-web
# RITSEI_OIDC_AUTHORIZATION_ENDPOINT=https://id.example.com/oauth2/authorize
# RITSEI_OIDC_TOKEN_ENDPOINT=https://id.example.com/oauth2/token
# RITSEI_OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
# RITSEI_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# RITSEI_OIDC_SCOPES=openid profile email
# PostgreSQL 19 replica read-your-writes is disabled until a reviewed standby is configured.
RITSEI_POSTGRES_RYW_ENABLED=false
# POSTGRES_REPLICA_URL=postgresql://ritsei_query:change-me@127.0.0.1:5434/ritsei
# RITSEI_POSTGRES_PLACEMENT_ID=local-cluster
# RITSEI_POSTGRES_CONSISTENCY_SECRET=replace-with-at-least-32-bytes
# RITSEI_POSTGRES_RYW_MAX_WAIT_MS=1000
# RITSEI_POSTGRES_CONSISTENCY_TTL_MS=300000
# Set TIGERBEETLE_* only when RITSEI_FINANCIAL_AUTHORITY=tigerbeetle.
# TIGERBEETLE_CLUSTER_ID=0
# TIGERBEETLE_REPLICA_ADDRESSES=127.0.0.1:3000
# TIGERBEETLE_LEDGER=1
# TIGERBEETLE_CODE=1
# TIGERBEETLE_CURRENCY=USD
WORKER_TENANT_ID=00000000-0000-4000-8000-000000000001
WORKER_ID=accounting-worker-local
